; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Shards Of Arcanum"
config/version="0.1.1"
run/main_scene="res://Scenes/Boot.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
boot_splash/image="uid://dj1476a6hb1e"
config/icon="uid://dem6rrpb323ok"

[autoload]

SignalBus="*res://Core/SignalBus.gd"
GameState="*res://Core/GameState.gd"
CombatManager="*res://Scripts/Managers/CombatManager.gd"
GameLogger="*res://Core/GameLogger.gd"
TargetSelectionManager="*res://Scripts/Managers/TargetSelectionManager.gd"
AudioManager="*res://Core/AudioManager.gd"
LoreManager="*res://Scripts/Singletons/LoreManager.gd"
MenuKit="*res://addons/game_menu_kit/menu_kit.gd"
PulseLiteUI="*res://addons/pulselite_ui/PulseLiteUI.gd"
SettingsManager="*res://addons/settings_menu/SettingsManager.gd"
DebugMenu="*res://Scripts/Testing/DebugMenu.gd"

[display]

window/size/viewport_width=1152
window/size/viewport_height=648
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/dice_roller/plugin.cfg", "res://addons/game_menu_kit/plugin.cfg", "res://addons/gut/plugin.cfg", "res://addons/pulselite_ui/plugin.cfg", "res://addons/settings_menu/plugin.cfg")

