class_name MenuKitSounds
extends Node
## Interface sounds, generated by code at startup (the kit ships no audio file).
##
## Three packs: [code]"soft"[/code] (default, short soft taps), [code]"felt"[/code]
## (muffled clicks) and [code]"minimal"[/code] (no hover / slider sounds). Hover
## always plays the same sound, whatever the button. Each style tints the pack with
## its own pitch and a little room reverb.
## Play one from your own UI: [code]MenuKit.sounds.play(&"select")[/code].

## Names accepted by [method play].
const SOUND_NAMES: Array[StringName] = [
	&"move", &"select", &"open", &"back", &"tick", &"toggle_on", &"toggle_off", &"deny", &"done",
]
const PACKS: PackedStringArray = ["soft", "felt", "minimal", "off"]
const MIX_RATE: int = 44100
const PLAYER_COUNT: int = 8
const MOVE_INTERVAL_MS: int = 60
const TICK_INTERVAL_MS: int = 55
const QUIET_AFTER_PANEL_MS: int = 180

## Sound pack: "soft", "felt", "minimal" or "off".
var pack: String = "soft":
	set(value):
		pack = value if PACKS.has(value) else "soft"
		_streams.clear()
## Plays [code]move[/code] when the focus moves (option "Hover sounds").
var hover_enabled: bool = true
## Audio bus of the interface sounds (created by the kit if missing).
var bus: StringName = &"UI"

var _pitch: float = 1.0
var _room: float = 0.05
var _streams: Dictionary = {}
var _players: Array[AudioStreamPlayer] = []
var _next_player: int = 0
var _last_move_ms: int = -100000
var _last_tick_ms: int = -100000
var _quiet_until_ms: int = 0


func _enter_tree() -> void:
	if get_child_count() > 0:
		return
	process_mode = Node.PROCESS_MODE_ALWAYS
	for i: int in PLAYER_COUNT:
		var player: AudioStreamPlayer = AudioStreamPlayer.new()
		player.name = "Voice%d" % i
		add_child(player)
		_players.append(player)


## Style tint: [param pitch] multiplies every frequency, [param room] is the reverb level.
func set_tint(pitch: float, room: float) -> void:
	if is_equal_approx(pitch, _pitch) and is_equal_approx(room, _room):
		return
	_pitch = pitch
	_room = room
	_streams.clear()


## Plays one of [constant SOUND_NAMES].
func play(sound: StringName) -> void:
	if pack == "off":
		return
	var now: int = Time.get_ticks_msec()
	match sound:
		&"move":
			if not hover_enabled or now < _quiet_until_ms or now - _last_move_ms < MOVE_INTERVAL_MS:
				return
			_last_move_ms = now
		&"tick":
			if now - _last_tick_ms < TICK_INTERVAL_MS:
				return
			_last_tick_ms = now
		&"open", &"back":
			_quiet_until_ms = now + QUIET_AFTER_PANEL_MS
	var stream: AudioStreamWAV = get_stream(sound)
	if stream == null or _players.is_empty():
		return
	var player: AudioStreamPlayer = _players[_next_player]
	_next_player = (_next_player + 1) % _players.size()
	player.bus = bus if AudioServer.get_bus_index(bus) != -1 else &"Master"
	player.stream = stream
	player.play()


## Plays the on / off switch sound.
func play_toggle(on: bool) -> void:
	play(&"toggle_on" if on else &"toggle_off")


## Silences the hover sound for a moment (used when a panel opens).
func hush(milliseconds: int = QUIET_AFTER_PANEL_MS) -> void:
	_quiet_until_ms = maxi(_quiet_until_ms, Time.get_ticks_msec() + milliseconds)


## Generated stream of a sound for the current pack and tint ([code]null[/code]
## when the pack has no such sound).
func get_stream(sound: StringName) -> AudioStreamWAV:
	if _streams.has(sound):
		return _streams[sound] as AudioStreamWAV
	var stream: AudioStreamWAV = _build(pack, sound, _pitch, _room)
	_streams[sound] = stream
	return stream


## Builds every sound of the pack now (avoids a tiny delay on first use).
func warm_up() -> void:
	for sound: StringName in SOUND_NAMES:
		get_stream(sound)


static func _build(pack_name: String, sound: StringName, k: float, room: float) -> AudioStreamWAV:
	var synth: _Synth = _Synth.new(MIX_RATE, 1.0 + (0.9 if room > 0.0 else 0.0))
	var gain: float = 0.9
	match pack_name:
		"soft":
			if not _soft(synth, sound, k):
				return null
		"minimal":
			if sound == &"move" or sound == &"tick" or not _soft(synth, sound, k):
				return null
			gain *= 0.8
		"felt":
			if not _felt(synth, sound, k):
				return null
		_:
			return null
	synth.add_room(room)
	synth.scale(gain)
	return synth.to_stream()


static func _soft(s: _Synth, sound: StringName, k: float) -> bool:
	match sound:
		&"move":
			s.tone(0.0, 520.0 * k, 0.07, 0.09, 0.003, 520.0 * k * 0.92, 0.05)
			s.noise(0.0, 0.012, 0.02, _Synth.LOWPASS, 2200.0, 0.0, 0.7, 0.001)
		&"select":
			s.tone(0.0, 300.0 * k, 0.12, 0.2, 0.002, 210.0 * k, 0.06)
			s.noise(0.0, 0.018, 0.05, _Synth.BANDPASS, 1500.0, 0.0, 1.0, 0.001)
		&"open":
			s.noise(0.0, 0.28, 0.07, _Synth.LOWPASS, 300.0, 1800.0, 0.6, 0.1)
		&"back":
			s.noise(0.0, 0.22, 0.06, _Synth.LOWPASS, 1600.0, 300.0, 0.6, 0.03)
			s.tone(0.0, 260.0 * k, 0.08, 0.07, 0.004, 210.0 * k, 0.05)
		&"tick":
			s.tone(0.0, 680.0 * k, 0.018, 0.035, 0.001)
		&"toggle_on":
			s.tone(0.0, 430.0 * k, 0.08, 0.1, 0.004, 500.0 * k, 0.05)
		&"toggle_off":
			s.tone(0.0, 500.0 * k, 0.08, 0.1, 0.004, 430.0 * k, 0.05)
		&"deny":
			s.tone(0.0, 190.0 * k, 0.07, 0.08)
			s.tone(0.09, 170.0 * k, 0.09, 0.08)
		&"done":
			s.tone(0.0, 660.0 * k, 0.7, 0.05, 0.003)
			s.tone(0.0, 1320.0 * k, 0.35, 0.0125, 0.003)
		_:
			return false
	return true


static func _felt(s: _Synth, sound: StringName, k: float) -> bool:
	match sound:
		&"move":
			s.noise(0.0, 0.014, 0.14, _Synth.BANDPASS, 1300.0 * k, 0.0, 1.3, 0.001)
		&"select":
			s.noise(0.0, 0.03, 0.13, _Synth.LOWPASS, 900.0, 0.0, 0.7, 0.001)
			s.tone(0.0, 150.0 * k, 0.07, 0.14, 0.002, 105.0 * k, 0.05)
		&"open":
			s.noise(0.0, 0.22, 0.06, _Synth.BANDPASS, 600.0, 1400.0, 0.9, 0.06)
		&"back":
			s.noise(0.0, 0.2, 0.1, _Synth.BANDPASS, 1400.0, 500.0, 0.9, 0.02)
		&"tick":
			s.noise(0.0, 0.007, 0.08, _Synth.BANDPASS, 2000.0, 0.0, 1.5, 0.001)
		&"toggle_on", &"toggle_off":
			var on: bool = sound == &"toggle_on"
			s.noise(0.0, 0.01, 0.16, _Synth.BANDPASS, 1500.0 if on else 1100.0, 0.0, 1.5, 0.001)
			s.noise(0.035, 0.01, 0.12, _Synth.BANDPASS, 1100.0 if on else 1500.0, 0.0, 1.5, 0.001)
		&"deny":
			s.tone(0.0, 140.0 * k, 0.06, 0.08)
			s.tone(0.08, 120.0 * k, 0.08, 0.08)
		&"done":
			s.tone(0.0, 520.0 * k, 0.4, 0.045, 0.01)
		_:
			return false
	return true


## Tiny offline synthesizer: sine tones, filtered noise, small room reverb.
class _Synth:
	extends RefCounted

	const LOWPASS: int = 0
	const BANDPASS: int = 1
	const FLOOR: float = 0.0001

	var rate: float
	var data: PackedFloat32Array = PackedFloat32Array()

	func _init(p_rate: int, seconds: float) -> void:
		rate = float(p_rate)
		data.resize(int(ceil(seconds * rate)))

	## Sine tone with an exponential pitch glide from [param f] to [param f2].
	func tone(t: float, f: float, dur: float, gain: float, atk: float = 0.004,
			f2: float = 0.0, glide: float = 0.0) -> void:
		var start: int = int(t * rate)
		var count: int = mini(int((dur + 0.03) * rate), data.size() - start)
		var glide_time: float = glide if glide > 0.0 else dur * 0.5
		var phase: float = 0.0
		for i: int in count:
			var time: float = float(i) / rate
			var freq: float = f
			if f2 > 0.0:
				freq = f * pow(f2 / f, minf(time / glide_time, 1.0))
			phase += TAU * freq / rate
			data[start + i] += sin(phase) * _envelope(time, dur, gain, atk)

	## White noise through a low-pass or band-pass filter whose frequency glides
	## from [param f] to [param f2].
	func noise(t: float, dur: float, gain: float, filter: int, f: float, f2: float,
			q: float, atk: float = 0.01) -> void:
		var start: int = int(t * rate)
		var count: int = mini(int((dur + 0.03) * rate), data.size() - start)
		var seed_value: int = 11
		var x1: float = 0.0
		var x2: float = 0.0
		var y1: float = 0.0
		var y2: float = 0.0
		var b0: float = 0.0
		var b1: float = 0.0
		var b2: float = 0.0
		var a1: float = 0.0
		var a2: float = 0.0
		for i: int in count:
			var time: float = float(i) / rate
			if i % 32 == 0:
				var freq: float = f
				if f2 > 0.0:
					freq = f * pow(f2 / f, minf(time / dur, 1.0))
				var w0: float = TAU * clampf(freq, 10.0, rate * 0.45) / rate
				var cos_w: float = cos(w0)
				var alpha: float
				var a0: float
				if filter == LOWPASS:
					# Same resonance convention as the Web Audio low-pass (Q in dB).
					alpha = sin(w0) / (2.0 * pow(10.0, q / 20.0))
					a0 = 1.0 + alpha
					b0 = (1.0 - cos_w) * 0.5 / a0
					b1 = (1.0 - cos_w) / a0
					b2 = b0
				else:
					alpha = sin(w0) / (2.0 * maxf(q, 0.0001))
					a0 = 1.0 + alpha
					b0 = alpha / a0
					b1 = 0.0
					b2 = -alpha / a0
				a1 = -2.0 * cos_w / a0
				a2 = (1.0 - alpha) / a0
			seed_value = (seed_value * 16807) % 2147483647
			var x0: float = float(seed_value) / 2147483647.0 * 2.0 - 1.0
			var y0: float = b0 * x0 + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2
			x2 = x1
			x1 = x0
			y2 = y1
			y1 = y0
			data[start + i] += y0 * _envelope(time, dur, gain, atk)

	## Small Schroeder room (4 damped combs + 2 all-pass filters) mixed at [param wet].
	func add_room(wet: float) -> void:
		if wet <= 0.0:
			return
		var size: int = data.size()
		var ratio: float = rate / 44100.0
		var wet_signal: PackedFloat32Array = PackedFloat32Array()
		wet_signal.resize(size)
		for delay_44k: int in [1116, 1188, 1277, 1356]:
			var delay: int = maxi(1, int(delay_44k * ratio))
			var line: PackedFloat32Array = PackedFloat32Array()
			line.resize(delay)
			var index: int = 0
			var damped: float = 0.0
			for i: int in size:
				var delayed: float = line[index]
				damped = delayed * 0.75 + damped * 0.25
				line[index] = data[i] + damped * 0.78
				index += 1
				if index >= delay:
					index = 0
				wet_signal[i] += delayed
		for delay_44k: int in [556, 441]:
			var delay: int = maxi(1, int(delay_44k * ratio))
			var line: PackedFloat32Array = PackedFloat32Array()
			line.resize(delay)
			var index: int = 0
			for i: int in size:
				var delayed: float = line[index]
				var output: float = delayed - wet_signal[i]
				line[index] = wet_signal[i] + delayed * 0.5
				wet_signal[i] = output
				index += 1
				if index >= delay:
					index = 0
		var mix: float = wet * 0.3
		for i: int in size:
			data[i] += wet_signal[i] * mix

	func scale(gain: float) -> void:
		for i: int in data.size():
			data[i] *= gain

	## 16-bit mono stream, trimmed after the last audible sample.
	func to_stream() -> AudioStreamWAV:
		var last: int = data.size() - 1
		while last > 0 and absf(data[last]) < FLOOR:
			last -= 1
		var count: int = last + 1
		var bytes: PackedByteArray = PackedByteArray()
		bytes.resize(count * 2)
		for i: int in count:
			bytes.encode_s16(i * 2, int(clampf(data[i], -1.0, 1.0) * 32767.0))
		var stream: AudioStreamWAV = AudioStreamWAV.new()
		stream.format = AudioStreamWAV.FORMAT_16_BITS
		stream.mix_rate = int(rate)
		stream.stereo = false
		stream.data = bytes
		return stream

	static func _envelope(time: float, dur: float, gain: float, atk: float) -> float:
		if time < atk:
			return gain * time / atk
		if time >= dur:
			return 0.0
		return gain * pow(FLOOR / gain, (time - atk) / maxf(dur - atk, 0.0001))
