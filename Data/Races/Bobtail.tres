[resource]
script = ExtResource("1_kcyru")
breed_name = "Bobtail"
description = "A sleek and tiny breed, the Japanese Bobtail is a dexterous and busy type able to maneuver its body (and especially its quick paws) into and out of the tightest situations. The Bobtail is also well known as a charming conversationalist and for its amazing friendliness and hospitality. Bobtails with lesser inclinations frequently use their sweet meows and quick claws to help themselves to goods and information. RESISTANCES: The Japanese Bobtail has resistance to Magic-realm spells."
base_intelligence = 7
base_piety = 6
base_vitality = 9
base_dexterity = 10
base_speed = 7
base_personality = 13
